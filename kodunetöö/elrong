#!/bin/bash
# Elroni rongiinfo skript

# 1. Definieerime värvikoodid terminali teksti jaoks
PUNANE='\033[0;31m'
ROHELINE='\033[0;32m'
RESET='\033[0m'

# 2. Kuvame menüü
echo "ELRONI RONGIINFO"
echo ""
echo "Vali marsruut:"
echo ""
echo "1 - Tartu → Tallinn"
echo "2 - Tartu → Valga"
echo "3 - Tartu → Koidula"
echo ""
read -p "Sisesta valik: " valik

# 3. Kontrollime, kas kasutaja jättis sisendi tühjaks
if [ -z "$valik" ]; then
    echo "Valik jäi sisestamata."
    exit 1
fi

# 4. Määrame lähte- ja sihtjaama vastavalt valikule
case $valik in
    1)
        lahtejaam="Tartu"
        sihtjaam="Tallinn"
        ;;
    2)
        lahtejaam="Tartu"
        sihtjaam="Valga"
        ;;
    3)
        lahtejaam="Tartu"
        sihtjaam="Koidula"
        ;;
    *)
        echo "Vigane valik!"
        exit 1
        ;;
esac

# 5. Pärime andmed Elroni API-st
api_vastus=$(curl -s "https://elron.ee/live-map/stop/$lahtejaam")

# Kontrollime, kas API päring õnnestus
if [ $? -ne 0 ] || [ -z "$api_vastus" ]; then
    echo "Elroni API päring ebaõnnestus."
    exit 1
fi

# 6. Filtreerime välja sobiva sihtjaamaga rongid
# sed paneb iga rongi eraldi reale, grep jätab alles õige sihtjaama
sobivad_rongid=$(echo "$api_vastus" | sed 's/},{/}\n{/g' | grep "\"sihtjaam\":\"$sihtjaam\"")

# Kontrollime, kas leiti sobivaid ronge
if [ -z "$sobivad_rongid" ]; then
    echo "Sobivaid ronge ei leitud."
    exit 1
fi

# 7. Eraldame väljumisajad (kellaajad)
ajad=$(echo "$sobivad_rongid" | grep -o '"plaaniline_aeg":"[0-9:]*"' | cut -d'"' -f4)

# 8. Saame süsteemi praeguse kellaaja ja kuvame päise
praegune_aeg=$(date +%H:%M)

echo ""
echo "$lahtejaam → $sihtjaam"
echo "Praegune kellaaeg: $praegune_aeg"
echo ""
echo "Väljumised:"
echo ""

# 9. Lõikame väljumisajad eraldi muutujatesse ilma tsüklita (ridade kaupa)
aeg1=$(echo "$ajad" | sed -n '1p')
aeg2=$(echo "$ajad" | sed -n '2p')
aeg3=$(echo "$ajad" | sed -n '3p')
aeg4=$(echo "$ajad" | sed -n '4p')

# 10. Kontrollime ja kuvame iga väljumise eraldi
if [ -n "$aeg1" ]; then
    if [[ "$aeg1" < "$praegune_aeg" ]]; then
        echo -e "${PUNANE}$aeg1  rong on juba väljunud${RESET}"
    else
        echo -e "${ROHELINE}$aeg1  rong on veel ees${RESET}"
    fi
fi

if [ -n "$aeg2" ]; then
    if [[ "$aeg2" < "$praegune_aeg" ]]; then
        echo -e "${PUNANE}$aeg2  rong on juba väljunud${RESET}"
    else
        echo -e "${ROHELINE}$aeg2  rong on veel ees${RESET}"
    fi
fi

if [ -n "$aeg3" ]; then
    if [[ "$aeg3" < "$praegune_aeg" ]]; then
        echo -e "${PUNANE}$aeg3  rong on juba väljunud${RESET}"
    else
        echo -e "${ROHELINE}$aeg3  rong on veel ees${RESET}"
    fi
fi

if [ -n "$aeg4" ]; then
    if [[ "$aeg4" < "$praegune_aeg" ]]; then
        echo -e "${PUNANE}$aeg4  rong on juba väljunud${RESET}"
    else
        echo -e "${ROHELINE}$aeg4  rong on veel ees${RESET}"
    fi
fi
