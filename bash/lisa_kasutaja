#!/bin/bash
# Ülesanne 1 - kasutaja loomine käsurea parameetri abil
# Kasutamine: ./lisa_kasutaja <kasutajanimi>

if [ $# -ne 1 ]; then
    echo "Kasutamine: $0 <kasutajanimi>"
    exit 1
fi

kasutajanimi="$1"

# Kontrollime, kas kasutaja juba eksisteerib
if id "$kasutajanimi" &>/dev/null; then
    echo "Kasutaja $kasutajanimi on juba olemas!"
    exit 1
fi

# Loome kasutaja koos kodukataloogiga /home sees ja kopeerime /etc/skel peidetud failid (-m)
# Vaikimisi shell on /bin/bash (-s /bin/bash)
useradd -m -s /bin/bash "$kasutajanimi"

if [ $? -eq 0 ]; then
    echo "Kasutaja $kasutajanimi on edukalt loodud."
    exit 0
else
    echo "Kasutaja $kasutajanimi loomine ebaõnnestus."
    exit 1
fi
